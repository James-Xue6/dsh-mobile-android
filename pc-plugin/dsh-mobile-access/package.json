{
  "name": "dsh-mobile-access",
  "displayName": "手机接入",
  "version": "2.1.0",
  "description": "中文名：手机接入。一站式手机端接入插件：内置自维护的网络层 net/（WebSocket 服务、设备配对与鉴权、Cloudflare 隧道与公网自检、局域网监听、会话同步），并提供二维码接入编排、APK 分发与撤销设备界面。网络层 fork 自 MIT 许可的 dsh-plugin-mobile-gateway 0.9.0，此后由本仓库自己维护（见 net/UPSTREAM.md 与 THIRD-PARTY-NOTICES.md）。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "mobile",
    "pairing",
    "qr"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "THIRD-PARTY-NOTICES.md",
    "net/"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "ws": "^8.18.0",
    "qrcode": "^1.5.4"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "license": "MIT"
}
