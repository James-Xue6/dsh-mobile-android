<?xml version="1.0" encoding="utf-8"?>
<!--
  通知小图标（状态栏/通知栏左侧那只白图标）。

  为什么必须自己画一个：通知的 setSmallIcon 是按「发布通知的那个包」解析资源 id 的，
  用 android.R.drawable.* 在真机上解析不到、通知会直接不显示；而 App 手上只有一张
  彩色的 launcher 图（mipmap），拿它当小图标在状态栏上就是一块白方块。
  minSdk 26（>= API 21），矢量图原生支持，所以直接放一个 24dp 的白色单色图。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
