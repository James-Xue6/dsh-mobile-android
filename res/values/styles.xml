<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      android:forceDarkAllowed="false" 是「一块黑」的治本开关（2026-10-02 真机 bug）：
      本主题是 Light 系（isLightTheme=true），而 forceDarkAllowed 对 Light 主题**默认就是 true** ——
      于是系统一开深色模式，系统/ROM 的「强制深色」会把界面里亮度较高的绘制内容（白卡片、
      浅色底、浅底上的字）按亮度整体压暗，看起来就是"浅色界面里冒出一块块黑"。
      本 App 的深浅色完全由自己（Store.themeMode + Ui.applyTheme）决定，
      绝不能让系统再插一手，所以显式关掉它。
      该属性 API 29 才有；minSdk 26 上系统不认这个 attr id，只是被忽略（不会崩）。
    -->
    <style name="AppTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorAccent">@color/brand</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <!-- 系统选择器 / 下拉的强调色也走 iOS 系统蓝 -->
        <item name="android:colorControlHighlight">#330A84FF</item>
    </style>

    <style name="AppTheme.Translucent" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:colorAccent">@color/brand</item>
    </style>

    <!--
      对话框主题：手搓界面能深浅切换，但系统 AlertDialog 的外观来自 Theme，
      而 AppTheme 是 Light 系 —— 深色模式下会弹出一张刺眼的白底框，和界面完全脱节。
      所以显式给它两套，由 Ui.dialog(ctx) 按当前主题挑一套。
      只用框架自带的 Theme.Material.*.Dialog.Alert，不引入任何新依赖。

      iOS 化：圆角 24dp（dialogCornerRadius / API 28+，旧系统忽略该属性）、
      浮动底走 iOS 的卡片色（浅 #FFFFFF / 深 #1C1C1E，靠 colorBackgroundFloating 换掉
      Material 的 #FFFFFF/#424242，形状与内衬由框架原样保留）、按钮强调色 = 系统蓝。
    -->
    <style name="DshDialog" parent="@android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:colorAccent">@color/brand</item>
        <item name="android:colorBackgroundFloating">@color/surface</item>
        <item name="android:dialogCornerRadius">24dp</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/ink_secondary</item>
        <item name="android:colorControlHighlight">#330A84FF</item>
    </style>

    <style name="DshDialog.Dark" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:colorAccent">@color/brand</item>
        <item name="android:colorBackgroundFloating">@color/dialog_bg_dark</item>
        <item name="android:dialogCornerRadius">24dp</item>
        <item name="android:textColorPrimary">@color/ink_dark</item>
        <item name="android:textColorSecondary">@color/ink_secondary_dark</item>
        <item name="android:colorControlHighlight">#330A84FF</item>
    </style>
</resources>
