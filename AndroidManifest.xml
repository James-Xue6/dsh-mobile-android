<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.dsh.mobile"
    android:versionCode="28"
    android:versionName="0.87.1">

    <!-- 【AGP 9 新规】uses-sdk 标签不再允许控制 SDK 版本（AGP 9 起的 manifest 合并会直接报错）。
         版本改由构建侧提供：Gradle 走 app/build.gradle.kts，免 Gradle 管线走 build.ps1 的
         aapt2 min-sdk-version / target-sdk-version 参数（两处均已显式传入，故删除安全）。
         注：XML 注释内不能出现连续两个减号，上一版就是因此把 manifest 写成语法错误。 -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- 通知：Android 13+ 是运行时权限，首次进入时申请（见 MainActivity.maybeAskNotificationPermission）。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 后台保持接收的前台服务（KeepAliveService）：
         FOREGROUND_SERVICE 是基础权限；CONNECTED_DEVICE / SPECIAL_USE 是 Android 14+
         按服务类型各自要求的权限（类型见下面 <service> 的 foregroundServiceType）。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- 应用内更新：下载完 APK 后拉起系统安装器（Android 8+ 必需；用户仍会看到系统确认框）。 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/AppTheme"
        android:forceDarkAllowed="false"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:enableOnBackInvokedCallback="false"
        android:supportsRtl="false">

        <activity
            android:name="com.dsh.mobile.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density|fontScale"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.dsh.mobile.ui.QrScanActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.Translucent" />

        <!-- [2026-10-07 合并朋友 fork] 交付物（生成物）应用内预览：点一下就在这里看，
             不用先下载到手机、再离开 App 去文件管理里找。只读本 App 自己 cache 下的文件，
             exported="false"（只有本 App 能拉起），不新增任何对外暴露面。 -->
        <activity
            android:name="com.dsh.mobile.ui.ArtifactActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme" />

        <!-- [另起原型] 真毛玻璃首页 demo（入口已回 MainActivity，此页保留可手动启动） -->
        <activity
            android:name="com.dsh.mobile.proto.GlassHomeActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme"
            android:label="玻璃Demo" />

        <!-- [玻璃参数对比 · 非产品界面] 花哨彩色底图 + 8 个不同参数版本玻璃，定位最终质感 -->
        <activity
            android:name="com.dsh.mobile.proto.GlassCompareActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme"
            android:label="玻璃对比" />

        <!-- [手动调参 · 非产品界面] 9 个液态玻璃参数全部暴露成滑条，模拟器上手动调定位最终质感 -->
        <activity
            android:name="com.dsh.mobile.proto.GlassTunerActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme"
            android:label="玻璃调参" />

        <!-- [对齐自测 · 非产品界面] 多色分段背景 + 三档滚动补偿并排：
             一次性判定 Frost.capture 的滚动补偿该取 0 / +s / -s（见该类注释） -->
        <activity
            android:name="com.dsh.mobile.proto.GlassAlignActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme"
            android:label="玻璃对齐自测" />
        <!-- [路线 A 取证页] 折射观察窗：Compose + 官方 backdrop（io.github.kyant0），
             用于按《GlassUI_SPEC_折射观察窗.md》§5 自检清单逐条核对。 -->
        <activity
            android:name="com.dsh.mobile.glass.GlassEvidenceActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme"
            android:label="折射观察窗取证" />
        <!-- [路线 A 逐页替换 · 切片1] 设备页 Compose 骨架：背景进 layerBackdrop + 设备卡/添加设备用 RefractionWindow
             [V2.2 · 用户报「我打开的界面和你的截图不一样」] 原因：**新页面根本不在桌面图标里**
             （manifest 里只有 MainActivity 是 LAUNCHER 入口），用户点图标进的还是正式版旧页（Frost 引擎）。
             这里给新界面加一个**独立 launcher 入口**（标签区分开），让用户能一键打开新 UI 试玩；
             正式版的 MainActivity 入口不动，全部既有链路（网关/通知/保活）照旧。 -->
        <!-- [V3.106 · 发布前检查 B1] 桌面图标只能有一个：原来这里给原型页加了**独立 launcher 入口**，
             发布会变成**两个桌面图标**（`aapt2 dump badging` 实测 2 条 launchable-activity）✗。
             ⇒ 去掉 launcher intent-filter，只保留 `exported="true"`（adb / 自动化仍可 `am start -n` 直接拉起，
             开发与验收不受影响 ✓）。 -->
        <activity
            android:name="com.dsh.mobile.glass.GlassDevicePageActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme"
            android:label="掌上通·新界面">
        </activity>
        <!-- [路线 A 逐页替换 · 切片2] 对话页 Compose 骨架：顶栏 + 输入胶囊用 RefractionWindow -->
        <activity
            android:name="com.dsh.mobile.glass.GlassChatPageActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme"
            android:label="对话页(Compose)" />

        <!-- [V3.77 · 用户「插入图片和拍照最好增加一个选择图片裁剪的界面」→ 方案 A（自由裁剪）]
             自绘裁剪页：原图 + 可拖框体/拉四角，确认后按框裁剪（保持原分辨率）并回到"暂存待发"。 -->
        <activity
            android:name="com.dsh.mobile.glass.CropActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme"
            android:label="裁剪图片" />

        <!-- [路线 A 逐页替换 · 切片3] 设置页 Compose 切片：深色模式 / 配色（真实写库）+ 指向正式版的入口。
             用户报「点齿轮进入了不对的首页」→ 设备页齿轮改指本页，不再跳正式版首页。 -->
        <activity
            android:name="com.dsh.mobile.glass.GlassSettingsActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme"
            android:label="设置(Compose)" />

        <!-- [路线 A 逐页替换 · 切片4] 抽屉/会话列表 Compose 切片（**纯 Activity + GlassComposeHostOwner**，
             与 MainActivity 同构 ⇒ 谁再往抽屉里用 Compose Dialog 会在这里当场崩）。
             用途：抽屉在模拟器上没数据（需网关），本页用真对象拼演示数据，好验两处 ⋯ 的树内浮层菜单。 -->
        <activity
            android:name="com.dsh.mobile.glass.GlassSessionPageActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme"
            android:label="抽屉(Compose)" />

        <!-- 应用内更新：把下载好的 APK 以 content:// 交给系统安装器（Android 7+ 禁止 file://）。
             自写极简 provider（本项目不依赖 androidx，见 net/ApkFileProvider.java）：
             只读、只暴露 getExternalFilesDir(null)/updates 下的文件。 -->
        <provider
            android:name="com.dsh.mobile.net.ApkFileProvider"
            android:authorities="com.dsh.mobile.apk"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- 拍照输出：MediaStore.ACTION_IMAGE_CAPTURE 的 EXTRA_OUTPUT 必须是 content://
             （Android 7+ 禁止 file://，否则 FileUriExposedException）。本 provider 是手写的
             极简 ContentProvider（本项目不依赖 androidx），只暴露应用私有缓存目录下的
             capture/；URI 由 net/CaptureFileProvider.newCaptureUri() 自造（IMG_<ts>.jpg）。
             与上面 APK 那个 provider 相互独立：暴露目录不同、可写性不同，故不复用。 -->
        <provider
            android:name="com.dsh.mobile.net.CaptureFileProvider"
            android:authorities="com.dsh.mobile.capture"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- 后台保持接收：只挂一条低优先级常驻通知，让进程在后台不被挂起（否则收不到
             会话事件，任务完成/待审批的通知根本发不出来）。见 notify/KeepAliveService.java。
             connectedDevice 语义最贴，但它有运行时前置条件；specialUse 作为兜底，
             所以两个类型都声明（运行时会逐级降级地 startForeground）。 -->
        <service
            android:name="com.dsh.mobile.notify.KeepAliveService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice|specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="保持与用户自有电脑上 DSH 网关的长连接，以便在后台接收会话事件并提醒" />
        </service>
    </application>
</manifest>
