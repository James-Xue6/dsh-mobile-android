<?xml version="1.0" encoding="utf-8"?>
<!--
  液态玻璃引擎 Demo —— 独立演示 App（与 DSH Mobile 生产包完全隔离：不同包名/签名/构建产物）。
  启动页 = 玻璃效果展示；另有 adb 可直达的参数实验室页（见 README）。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.dsh.glassdemo">

    <application
        android:label="@string/app_name"
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".GlassEngineDemoActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".GlassLabActivity"
            android:exported="true"
            android:label="玻璃参数实验室"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode" />

        <!-- 路线 B 实证：不用 Compose，官方 AGSL 着色器直接画在 View 上（A/B 同屏对照） -->
        <activity
            android:name=".ShaderGlassActivity"
            android:exported="true"
            android:label="[已否决·存档]路线B"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode" />
    </application>
</manifest>
